# ---- Go (github/gitignore Go template) ----
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of `go tool cover`
*.out
coverage.*

# Dependency directory (rarely used with modules)
vendor/

# Go workspace file
go.work
go.work.sum

# ---- Projeto: binários compilados ----
rinha-fraud
rinha-fraud.exe
buildindex
buildindex.exe

# Índice de busca pré-construído (regenerado por cmd/buildindex / Docker build)
resources/index.bin

# Dataset de 3M vetores: grande, copiado no build, nunca commitado
resources/references.json.gz
resources/references.json

# Logs locais
*.log

# ---- Editores / SO ----
.idea/
.vscode/
*.swp
.DS_Store
